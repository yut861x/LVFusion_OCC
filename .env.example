# Copy to a file outside Git or export these variables in your shell.
export LVFUSION_OCC_ROOT=/path/to/LVFusion_OCC
export LVFUSION_OCC_DATA_ROOT=/path/to/dataset
export LVFUSION_ANNOTATION_ROOT=/path/to/lv_annotation_tools
export LVFUSION_OCC_DOCKER_DIR=/path/to/docker-images
export LVFUSION_OCC_IMAGE_TAR="$LVFUSION_OCC_DOCKER_DIR/lvfusion_docker_image_v1_1.tar"
